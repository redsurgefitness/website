---
//src/layouts/BaseLayout.astro
import "../styles/global.css";
import { SEO } from "astro-seo-kit";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description = "Red Surge Fitness: premium speed and weighted jump ropes plus expert jump rope training guides for athletes.",
  noindex = false,
  ogType = "website",
  image,
  imageAlt,
} = Astro.props;

const siteName = "Red Surge Fitness";
const site = Astro.site ?? new URL("https://redsurgefitness.com");
const canonicalURL = new URL(Astro.url.pathname, site);
const organizationId = `${site.origin}/#organization`;
const websiteId = `${site.origin}/#website`;
const logoUrl = new URL("/logo.png", site).href;

const openGraph = {
  type: ogType,
  siteName,
  url: canonicalURL.href,
  title,
  description,
  ...(image
    ? {
        images: [
          {
            url: new URL(image, site).href,
            alt: imageAlt ?? title,
          },
        ],
      }
    : {}),
};

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: site.origin,
      name: siteName,
      description:
        "Premium jump ropes and training guides for athletes who condition seriously.",
      publisher: { "@id": organizationId },
      inLanguage: "en-US",
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      name: siteName,
      url: site.origin,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
      },
      description:
        "Premium jump ropes and training insights for athletes who want to move faster and condition harder.",
      sameAs: [
        "https://www.instagram.com/cstewruns",
        "https://www.tiktok.com/@cstewruns",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={openGraph}
      twitter={{ card: "summary_large_image" }}
    />

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body
    class="bg-gray-950 text-white font-sans antialiased min-h-screen flex flex-col"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-red-600 focus:px-4 focus:py-2 focus:rounded"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-gray-800 bg-gray-950/80 backdrop-blur"
    >
      <nav
        aria-label="Main navigation"
        class="max-w-7xl mx-auto px-6 lg:px-8 py-4 flex items-center justify-between"
      >
        <a
          href="/"
          aria-label="Red Surge Fitness home"
          class="text-xl font-black tracking-tight text-red-500"
        >
          RED SURGE
        </a>
        <div class="flex items-center gap-6 text-sm font-medium">
          <a href="/" class="hover:text-red-400 transition">Home</a>
          <a href="/about" class="hover:text-red-400 transition">About</a>
          <a href="/blog" class="hover:text-red-400 transition">Blog</a>
          <a href="/shop" class="hover:text-red-400 transition">Shop</a>

          <!-- Cart Link -->
          <a
            href="/cart"
            class="relative hover:text-red-400 transition flex items-center gap-1"
            aria-label="View Cart"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="8" cy="21" r="1"></circle>
              <circle cx="19" cy="21" r="1"></circle>
              <path
                d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"
              ></path>
            </svg>
            <span
              id="nav-cart-count"
              class="absolute -top-2 -right-3 bg-red-600 text-white text-xs font-bold px-1.5 py-0.5 rounded-full hidden"
              >0</span
            >
          </a>
        </div>
      </nav>
    </header>

    <main
      id="main-content"
      class="flex-1 max-w-7xl mx-auto w-full px-6 lg:px-8 py-12"
    >
      <slot />
    </main>

    <footer class="border-t border-gray-800 mt-20">
      <div
        class="max-w-7xl mx-auto px-6 lg:px-8 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-gray-400 text-sm"
      >
        <p>
          &copy; {new Date().getFullYear()} Red Surge Fitness. All rights reserved.
        </p>
        <div class="flex gap-6">
          <a href="/privacy" class="hover:text-white transition"
            >Privacy Policy</a
          >
          <a href="/terms" class="hover:text-white transition"
            >Terms of Service</a
          >
          <a href="/shipping-returns" class="hover:text-white transition"
            >Shipping & Returns</a
          >
        </div>
      </div>
    </footer>
    <!-- src/layouts/BaseLayout.astro (bottom of file, before </body>) -->
    <script>
      interface CartItem {
        variantId: number;
        quantity: number;
      }

      // 1. Core Cart Logic
      (window as any).getCart = function (): CartItem[] {
        return JSON.parse(localStorage.getItem("cart") || "[]");
      };

      (window as any).saveCart = function (cart: CartItem[]) {
        localStorage.setItem("cart", JSON.stringify(cart));
        window.dispatchEvent(new Event("cart-updated"));
      };

      (window as any).addToCart = function (
        variantId: number,
        quantity: number = 1,
      ) {
        const cart = (window as any).getCart();
        const existingItem = cart.find(
          (item: CartItem) => item.variantId === variantId,
        );
        if (existingItem) {
          existingItem.quantity += quantity;
        } else {
          cart.push({ variantId, quantity });
        }
        (window as any).saveCart(cart);
      };

      (window as any).goToCheckout = async function () {
        const cart = (window as any).getCart();
        if (cart.length === 0) return alert("Your cart is empty.");

        const response = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cart }),
        });

        // 1. Define the expected shape of the response
        interface CheckoutResponse {
          url?: string;
          error?: string;
        }

        // 2. Cast the response to the interface
        const data = (await response.json()) as CheckoutResponse;

        if (data.url) {
          window.location.href = data.url;
        } else {
          alert("Checkout failed: " + (data.error || "Unknown error"));
        }
      };

      // 2. Update the Navbar Cart Count
      function updateNavCartCount() {
        const cart = (window as any).getCart();
        const count = cart.reduce(
          (sum: number, item: CartItem) => sum + item.quantity,
          0,
        );
        const badge = document.getElementById("nav-cart-count");
        if (badge) {
          badge.textContent = count.toString();
          badge.classList.toggle("hidden", count === 0);
        }
      }

      document.addEventListener("DOMContentLoaded", updateNavCartCount);
      window.addEventListener("cart-updated", updateNavCartCount);
    </script>
  </body>
</html>
