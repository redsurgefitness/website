---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthor } from "../../lib/authors";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const site = Astro.site ?? new URL("https://redsurgefitness.com");

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// --- Author lookup ---
const authorEntry = await getAuthor(post.data.author);
const authorName = authorEntry?.data.name ?? post.data.author;
const authorRole = authorEntry?.data.role ?? "Red Surge Fitness";
const authorAvatar = authorEntry?.data.avatar;
const authorUrl = authorEntry ? `/authors/${authorEntry.id}/` : "/about";
const authorUrlAbsolute = new URL(authorUrl, site).href;

const authorInitials = authorName
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

// --- URLs & dates ---
const canonicalURL = new URL(Astro.url.pathname, site);
const postUrl = canonicalURL.href;
const dateModified = post.data.updatedDate ?? post.data.pubDate;

// --- Structured data ---
const organizationId = `${site.origin}/#organization`;
const personId = authorEntry
  ? `${authorUrlAbsolute}#person`
  : `${postUrl}#author`;

const person = authorEntry
  ? {
      "@type": "Person",
      "@id": personId,
      name: authorEntry.data.name,
      jobTitle: authorEntry.data.role,
      description: authorEntry.data.shortBio,
      url: authorUrlAbsolute,
      image: new URL(authorEntry.data.avatar, site).href,
      alumniOf: authorEntry.data.alumniOf.map((name) => ({
        "@type": "CollegeOrUniversity",
        name,
      })),
      knowsAbout: authorEntry.data.knowsAbout,
      sameAs: authorEntry.data.sameAs,
    }
  : {
      "@type": "Person",
      "@id": personId,
      name: authorName,
    };

const article = {
  "@type": "Article",
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  image: [new URL(post.data.heroImage, site).href],
  datePublished: post.data.pubDate.toISOString(),
  dateModified: dateModified.toISOString(),
  author: { "@id": personId },
  publisher: { "@id": organizationId },
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  keywords: post.data.tags.join(", "),
  isAccessibleForFree: true,
};

const faqPage =
  post.data.faq.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${postUrl}#faq`,
        mainEntity: post.data.faq.map(({ q, a }) => ({
          "@type": "Question",
          name: q,
          acceptedAnswer: { "@type": "Answer", text: a },
        })),
      }
    : null;

const breadcrumbs = {
  "@type": "BreadcrumbList",
  "@id": `${postUrl}#breadcrumbs`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog", site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: postUrl,
    },
  ],
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [person, article, faqPage, breadcrumbs].filter(Boolean),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  noindex={post.data.noindex}
  ogType="article"
  image={post.data.heroImage}
  imageAlt={post.data.heroImageAlt}
>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="mb-8">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-400">
      <li><a href="/" class="hover:text-red-400 transition">Home</a></li>
      <li aria-hidden="true" class="text-gray-600">/</li>
      <li><a href="/blog" class="hover:text-red-400 transition">Blog</a></li>
      <li aria-hidden="true" class="text-gray-600">/</li>
      <li class="text-gray-300 truncate max-w-xs" aria-current="page">
        {post.data.title}
      </li>
    </ol>
  </nav>

  <article>
    <!-- Post header -->
    <header class="mb-12">
      {
        post.data.tags.length > 0 && (
          <p class="text-xs uppercase tracking-[0.3em] text-red-500 mb-5 font-semibold">
            {post.data.tags[0]}
          </p>
        )
      }
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter mb-6 leading-[1.05]"
      >
        {post.data.title}
      </h1>
      <p
        class="text-lg md:text-xl text-gray-400 leading-relaxed max-w-6xl mb-8"
      >
        {post.data.description}
      </p>

      <!-- Author + meta bar -->
      <div
        class="flex flex-wrap items-center gap-x-4 gap-y-3 py-6 border-y border-gray-800"
      >
        <a href={authorUrl} rel="author" class="flex items-center gap-3 group">
          {
            authorAvatar ? (
              <img
                src={authorAvatar}
                alt=""
                width="40"
                height="40"
                class="w-10 h-10 rounded-full object-cover border border-gray-800"
              />
            ) : (
              <span
                aria-hidden="true"
                class="w-10 h-10 rounded-full bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center font-bold text-white text-sm"
              >
                {authorInitials}
              </span>
            )
          }
          <span class="flex flex-col">
            <span
              class="text-sm font-semibold text-white group-hover:text-red-400 transition"
            >
              {authorName}
            </span>
            <span class="text-xs text-gray-300">{authorRole}</span>
          </span>
        </a>
        <span aria-hidden="true" class="text-gray-700 hidden sm:inline">·</span>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="text-sm text-gray-400"
        >
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true" class="text-gray-700 hidden sm:inline">
                ·
              </span>
              <span class="text-sm text-gray-400">
                Updated{" "}
                <time datetime={dateModified.toISOString()}>
                  {formatDate(dateModified)}
                </time>
              </span>
            </>
          )
        }
        <span aria-hidden="true" class="text-gray-700 hidden sm:inline">·</span>
        <span class="text-sm text-gray-400">{readingTime} min read</span>
      </div>
    </header>

    <!-- Hero image -->
    {
      post.data.heroImage && (
        <figure class="mb-12">
          <img
            src={post.data.heroImage}
            alt={post.data.heroImageAlt}
            width="1600"
            height="840"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full rounded-2xl border border-gray-800 object-cover aspect-[1600/840]"
          />
        </figure>
      )
    }

    <!-- Post body -->
    <div
      class="prose prose-invert prose-lg max-w-6xl
             prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white
             prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-3xl
             prose-h3:mt-8 prose-h3:text-2xl
             prose-p:text-gray-300 prose-p:leading-relaxed
             prose-a:text-red-400 prose-a:no-underline hover:prose-a:underline
             prose-strong:text-white
             prose-code:text-red-300 prose-code:bg-gray-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
             prose-li:text-gray-300
             prose-blockquote:border-red-500 prose-blockquote:text-gray-400
             prose-table:text-sm"
    >
      <Content />
    </div>

    <!-- Tags -->
    {
      post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-gray-800">
          {post.data.tags.map((tag) => (
            <span class="text-xs uppercase tracking-widest text-gray-400 bg-gray-900 border border-gray-800 px-3 py-1.5 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Post footer CTA -->
    <aside
      class="mt-16 bg-gradient-to-br from-gray-900 to-gray-950 p-10 rounded-2xl border border-gray-800"
      aria-label="Shop call to action"
    >
      <h2 class="text-2xl md:text-3xl font-bold mb-3">
        Put this into practice
      </h2>
      <p class="text-gray-400 mb-6 max-w-xl">
        Browse our speed and weighted jump ropes — built for the training we
        write about.
      </p>
      <a
        href="/shop"
        class="inline-block bg-red-600 hover:bg-red-500 px-8 py-3 rounded-lg font-semibold transition"
      >
        Shop Jump Ropes
      </a>
    </aside>
  </article>

  <!-- Back link -->
  <div class="mt-12 pt-8 border-t border-gray-800">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-red-400 hover:text-red-300 font-semibold transition"
    >
      <span aria-hidden="true">←</span> Back to all articles
    </a>
  </div>
</BaseLayout>
