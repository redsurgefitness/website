---
// src/pages/shop.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { env } from "cloudflare:workers";

const site = Astro.site ?? new URL("https://redsurgefitness.com");
const canonicalURL = new URL(Astro.url.pathname, site);
const title = "Shop Premium Jump Ropes | Red Surge Fitness";
const description =
  "Browse our collection of competition-grade speed ropes and progressive weighted jump ropes built for serious athletes.";

// 1. Define the expected shape of your D1 data
interface ShopProduct {
  product_id: number;
  product_name: string;
  slug: string;
  description: string;
  image_url: string | null;
  variant_id: number;
  price_cents: number;
}

const query = `
  SELECT p.id as product_id, p.name as product_name, p.slug, p.description, p.image_url,
         v.id as variant_id, v.price_cents
  FROM products p
  JOIN product_variants v ON p.id = v.product_id
`;

// 2. Pass the interface to .all()
const { results: products } = await env.redsurge_shop
  .prepare(query)
  .all<ShopProduct>();

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalURL.href}#collection`,
  name: title,
  description,
  url: canonicalURL.href,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/shop/${product.slug}`, site).href,
      name: product.product_name,
    })),
  },
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section
    class="relative py-16 md:py-24 overflow-hidden"
    aria-labelledby="shop-heading"
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(220,38,38,0.12),transparent_60%)]"
      aria-hidden="true"
    >
    </div>
    <p
      class="text-xs uppercase tracking-[0.4em] text-red-500 mb-6 font-semibold"
    >
      The Gear
    </p>
    <h1
      id="shop-heading"
      class="text-5xl md:text-7xl font-black tracking-tighter mb-6 leading-[0.95] uppercase"
    >
      Built for <span class="text-red-500">Performance.</span>
    </h1>
    <p class="text-gray-400 text-lg md:text-xl max-w-2xl leading-relaxed mb-8">
      Competition-grade bearings, precision cables, and handles designed for
      unbroken sets.
    </p>
  </section>

  <section class="py-16 border-t border-gray-800">
    <div class="grid md:grid-cols-2 gap-8">
      {
        products.map((product) => (
          <a
            href={`/shop/${product.slug}`}
            class="group bg-gray-900 rounded-2xl border border-gray-800 hover:border-gray-700 transition overflow-hidden flex flex-col"
          >
            <div class="relative aspect-square overflow-hidden bg-gray-950 flex items-center justify-center">
              {product.image_url ? (
                <img
                  src={product.image_url}
                  alt={product.product_name}
                  width="600"
                  height="600"
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <span class="text-gray-600 font-medium">Image Coming Soon</span>
              )}
            </div>
            <div class="p-8 flex flex-col flex-1">
              <h2 class="text-2xl font-bold mb-2 group-hover:text-red-400 transition">
                {product.product_name}
              </h2>
              <p class="text-gray-400 text-sm leading-relaxed mb-6 flex-1">
                {product.description}
              </p>
              <div class="flex items-center justify-between mt-auto">
                <span class="text-xl font-bold text-white">
                  ${(product.price_cents / 100).toFixed(2)}
                </span>
                <span class="text-red-400 font-semibold text-sm flex items-center gap-1 group-hover:translate-x-1 transition">
                  View Details <span aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
