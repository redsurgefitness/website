---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
const site = Astro.site ?? new URL("https://redsurgefitness.com");

const posts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.author === author.id,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${Astro.url.href}#person`,
  name: author.data.name,
  jobTitle: author.data.role,
  description: author.data.bio,
  image: new URL(author.data.avatar, site).href,
  url: Astro.url.href,
  alumniOf: author.data.alumniOf.map((name) => ({
    "@type": "CollegeOrUniversity",
    name,
  })),
  knowsAbout: author.data.knowsAbout,
  sameAs: author.data.sameAs,
};

const profilePage = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: { "@id": `${Astro.url.href}#person` },
};
---

<BaseLayout
  title={`${author.data.name} — Author`}
  description={author.data.shortBio}
  image={author.data.avatar}
  imageAlt={`Portrait of ${author.data.name}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <script type="application/ld+json" set:html={JSON.stringify(profilePage)} />

  <nav aria-label="Breadcrumb" class="mb-8">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-400">
      <li><a href="/" class="hover:text-red-400 transition">Home</a></li>
      <li aria-hidden="true" class="text-gray-600">/</li>
      <li><a href="/about" class="hover:text-red-400 transition">About</a></li>
      <li aria-hidden="true" class="text-gray-600">/</li>
      <li class="text-gray-300" aria-current="page">{author.data.name}</li>
    </ol>
  </nav>

  <article class="max-w-3xl">
    <img
      src={author.data.avatar}
      alt={`Portrait of ${author.data.name}`}
      width="160"
      height="160"
      class="w-40 h-40 rounded-full object-cover border-2 border-gray-800 mb-6"
    />

    <h1 class="text-4xl md:text-5xl font-black tracking-tighter mb-2">
      {author.data.name}
    </h1>
    <p class="text-red-500 font-semibold mb-8">{author.data.role}</p>

    <p class="text-lg text-gray-300 leading-relaxed mb-10">
      {author.data.bio}
    </p>

    {
      author.data.credentials.length > 0 && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold mb-3">Credentials</h2>
          <ul class="list-disc list-inside text-gray-300 space-y-1">
            {author.data.credentials.map((credential) => (
              <li>{credential}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      author.data.knowsAbout.length > 0 && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold mb-3">Areas of expertise</h2>
          <div class="flex flex-wrap gap-2">
            {author.data.knowsAbout.map((topic) => (
              <span class="text-xs uppercase tracking-widest text-gray-400 bg-gray-900 border border-gray-800 px-3 py-1.5 rounded-full">
                {topic}
              </span>
            ))}
          </div>
        </section>
      )
    }

    {
      author.data.sameAs.length > 0 && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold mb-3">Find me</h2>
          <ul class="list-disc list-inside text-red-400 space-y-1">
            {author.data.sameAs.map((url) => (
              <li>
                <a
                  href={url}
                  rel="me noopener"
                  target="_blank"
                  class="hover:underline"
                >
                  {url}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2 class="text-2xl font-bold mb-3">
        Posts by {author.data.name}
      </h2>
      {
        posts.length > 0 ? (
          <ul class="space-y-3">
            {posts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}/`}
                  class="text-red-400 hover:text-red-300 font-semibold transition"
                >
                  {post.data.title}
                </a>
                <p class="text-sm text-gray-400 mt-1">
                  {post.data.description}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">No posts published yet.</p>
        )
      }
    </section>
  </article>
</BaseLayout>
